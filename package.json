{
  "name": "@koduhai/dmarc-parser",
  "version": "0.1.0",
  "description": "Parse DMARC aggregate (RUA) reports — XML, .gz/.zip, or raw MIME email — into typed JSON. Zero-config CLI + tiny library.",
  "keywords": [
    "dmarc",
    "dmarc-report",
    "dmarc-parser",
    "rua",
    "aggregate-report",
    "email",
    "deliverability",
    "spf",
    "dkim",
    "email-authentication"
  ],
  "license": "MIT",
  "author": "Koduhai",
  "homepage": "https://github.com/koduhai/dmarc-parser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koduhai/dmarc-parser.git"
  },
  "bugs": {
    "url": "https://github.com/koduhai/dmarc-parser/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dmarc-parser": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.0.0"
  }
}
