{
  "name": "@koduhai/dmarc-parser",
  "version": "0.3.0",
  "description": "Parse DMARC aggregate (RUA) reports — XML, .gz/.zip, or raw MIME email — into typed JSON. Zero-config CLI + tiny library.",
  "keywords": [
    "dmarc",
    "dmarc-report",
    "dmarc-parser",
    "rua",
    "aggregate-report",
    "email",
    "deliverability",
    "spf",
    "dkim",
    "email-authentication"
  ],
  "license": "MIT",
  "author": "Koduhai",
  "homepage": "https://github.com/koduhai/dmarc-parser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koduhai/dmarc-parser.git"
  },
  "bugs": {
    "url": "https://github.com/koduhai/dmarc-parser/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dmarc-parser": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:exports": "publint && attw --pack . --profile esm-only",
    "docs": "typedoc",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "mailparser": "^3.7.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.13.0",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "publint": "^0.3.21",
    "typedoc": "^0.28.19",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.0.0"
  }
}
